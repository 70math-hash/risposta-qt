# Copie para .env.local (front) e .dev.vars (worker). Nenhum dos dois vai para o git.

# --- Front (PWA e painel). Somente chave publica. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE=http://localhost:8787

# --- Worker. Nunca no bundle do front. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# A mesma chave publica do front. Serve so para o Worker perguntar ao Supabase de quem e o token
# da sessao do painel, na rota de importacao manual do R3. Nao escreve nada.
SUPABASE_ANON_KEY=
# O segredo JWT do projeto (Settings > API > JWT Settings). Com ele, o Worker escreve com as
# permissoes do papel restrito `experiencia_app`; sem ele, escreve como `service_role`, e nesse
# caso RLS e os grants por tabela nao valem. `GET /api/saude` diz qual esta ativo.
#
# NAO VERIFICADO: se o PostgREST hospedado aceita um papel CUSTOM no claim `role`, e se o projeto
# ainda tem o segredo HS256 legado (projetos novos migram para chaves assimetricas). Conferir na
# primeira implantacao com `curl .../api/saude`: se disser `service_role`, o caminho restrito nao
# esta ativo, e os documentos que descrevem a matriz de permissoes descrevem uma protecao ausente.
SUPABASE_JWT_SECRET=
RESEND_API_KEY=
GROQ_API_KEY=
DRIVE_SA_JSON=
