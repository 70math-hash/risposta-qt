# Copie para .env.local (front) e .dev.vars (worker). Nenhum dos dois vai para o git.

# --- Front (PWA e painel). Somente chave publica. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE=http://localhost:8787

# --- Worker. Nunca no bundle do front. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# A mesma chave publica do front. Serve so para o Worker perguntar ao Supabase de quem e o token
# da sessao do painel, na rota de importacao manual do R3. Nao escreve nada.
SUPABASE_ANON_KEY=
RESEND_API_KEY=
GROQ_API_KEY=
DRIVE_SA_JSON=
